# Server Port
PORT=5001

# MongoDB Connection String (Leave default for local MongoDB, or put MongoDB Atlas URI)
# If local MongoDB is not running, the app automatically switches to its high-performance embedded fallback store
MONGODB_URI=mongodb://127.0.0.1:27017/lumina_ecommerce

# JWT Secret for Auth Tokens (change this in production!)
JWT_SECRET=lumina_jwt_super_secret_example_key
