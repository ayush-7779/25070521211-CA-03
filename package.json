{
  "name": "lumina-ecommerce",
  "version": "1.0.0",
  "private": true,
  "description": "Lumina – Full Stack E-Commerce (React + Node.js + MongoDB)",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"node server/server.js\" \"npm run dev --prefix client\"",
    "dev:server": "node server/server.js",
    "dev:client": "npm run dev --prefix client",
    "install:all": "npm install && npm install --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  }
}
